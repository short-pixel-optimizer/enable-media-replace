# Build-tool dependencies (composer.json). composer.lock is not tracked.
vendor
composer.lock
# Test-only dependencies (composer.tests.json) — composer.tests.lock IS tracked.
vendor-tests
.phpunit.result.cache
*.log
.DS_Store
.env.local
.env.testing
/composer.phar
/.idea
/wordpress/
# Commercial partner-plugin zips for bin/test.sh --compat (WPML etc.) —
# never commit these; drop the zip in and the harness picks it up.
/tests/partner-plugins/
# Commercial partner-theme zips (Bricks) — same rule, extracted into themes/.
/tests/partner-themes/
# Manual tests, not needed in the repo
/tests/manual/
# Browser E2E suite (bin/test-e2e.sh): dependencies + run output.
# package-lock.json IS tracked (reproducible installs in CI).
/tests/E2E/node_modules/
/tests/E2E/artifacts/
/tests/E2E/test-results/
/tests/E2E/playwright-report/
# Claude Code: personal settings and temporary worktrees. A shared
# .claude/settings.json (if ever added) is meant to be committed.
/.claude/settings.local.json
/.claude/worktrees/
